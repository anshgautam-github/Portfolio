+/* the break: pieces are small flat copies, so none of the card's own effects are needed inside them */
+.ff-shards .ff-shardcard, .ff-shards .ff-shardcard * { will-change: auto !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
