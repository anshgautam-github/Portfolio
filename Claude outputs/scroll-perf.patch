+  mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0.08) 60%, transparent);
+  transition: background-color 0.9s ease;
+}
+@media (min-width: 901px) and (pointer: fine) {
+  .ff-aur { filter: none; transition: background-color 0.9s ease; }
+  .ff-aur--a { background: var(--glow); -webkit-mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0.42), transparent); mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0.42), transparent); }
+  .ff-aur--b { background: var(--glow); -webkit-mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0.36), transparent); mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0.36), transparent); }
